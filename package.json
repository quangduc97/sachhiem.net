    "@fontsource/playfair-display": "^5.2.5",
    "astro": "^5.12.0"
  },
  "devDependencies": {
    "cheerio": "^1.1.0",
    "pagefind": "^1.5.2",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "pagefind@1.5.2": true
  }
}
