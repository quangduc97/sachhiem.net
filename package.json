{
  "name": "sachhiem-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/index-articles.mjs && NODE_OPTIONS=--max-old-space-size=4096 astro dev",
    "build": "node scripts/index-articles.mjs && NODE_OPTIONS=--max-old-space-size=8192 astro build && pagefind --site dist",
